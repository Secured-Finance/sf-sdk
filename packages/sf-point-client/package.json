{
  "name": "@secured-finance/sf-point-client",
  "version": "0.2.0-beta.187",
  "description": "GraphQL react client for the point dashboard",
  "main": "./dist/types.js",
  "module": "./dist/types.mjs",
  "types": "./dist/types.d.ts",
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "prebuild": "if [ -n \"$SCHEMA_URL\" ]; then npm run codegen; else echo 'Skipping codegen - SCHEMA_URL not set'; fi",
    "build": "tsup"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "graphql": "^16.8.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typescript": "^4.0.7",
    "@graphql-codegen/typescript-react-apollo": "^4.3.0",
    "@graphql-codegen/typescript-resolvers": "^4.1.0",
    "dotenv": "^16.4.5",
    "tsup": "^8.0.2",
    "typescript": "^5.1.6"
  }
}
