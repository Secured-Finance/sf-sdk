{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "module": "commonjs",
    "moduleResolution": "node",
    // viem/ox ship ESM-only type declarations, so classic resolution type-checks
    // their .ts sources; they require ES2022 lib features (emit target unchanged).
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "esModuleInterop": true
  },
  "include": ["src"],
  "exclude": ["dist", "examples", "**/*.test.ts", "**/*.test.js"],
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
